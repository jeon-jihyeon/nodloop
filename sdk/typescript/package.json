{
  "name": "nodloop",
  "version": "0.6.6",
  "description": "Record AI runs and the verdicts people give on them, and hand the knowledge they approve to the next run in the same place",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeon-jihyeon/nodloop.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/jeon-jihyeon/nodloop#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./claude-agent": "./dist/claude-agent.js",
    "./langchain": "./dist/langchain.js",
    "./openai-agents": "./dist/openai-agents.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.1",
    "@langchain/core": ">=1.0",
    "@openai/agents": ">=0.1",
    "langchain": ">=1.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "langchain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.1.0",
    "@langchain/core": "^1.2.13",
    "@openai/agents": ">=0.3.0",
    "@types/node": "^26.6.3",
    "langchain": "^1.5.14",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "ai",
    "agents",
    "feedback",
    "human-in-the-loop",
    "langchain",
    "mcp",
    "memory"
  ]
}
