{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "gofmt-hook",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/other-hook",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "/Users/me/go/bin/nodloop guard",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(go test *)"
    ]
  },
  "unknownFutureKey": {
    "keep": true
  }
}
