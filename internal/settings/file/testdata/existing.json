{
  "permissions": {
    "allow": ["Bash(go test *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "/usr/local/bin/other-hook", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "gofmt-hook"}
        ]
      }
    ]
  },
  "unknownFutureKey": {"keep": true}
}
