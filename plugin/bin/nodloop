#!/bin/sh
# Finds or fetches the nodloop binary of this plugin's version and runs it with the given arguments
# 1. `~/.nodloop/bin/v<version>/nodloop` when a previous run fetched it
# 2. the GitHub release of that version for this OS and architecture verified against its `checksums.txt`
# 3. go install of the same version when Go is present and the release could not be fetched
# 4. another nodloop on PATH when it answers the plugin version, or any version when NODLOOP_ALLOW_PATH is 1
# Every source that runs is linked from the stable path so that path names the binary the plugin ran last
# The version is read from the plugin manifest so the plugin and the binary it runs never drift
set -eu

REPO="jeon-jihyeon/nodloop"
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
MANIFEST="${ROOT}/.claude-plugin/plugin.json"

version=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST" | head -n 1)
if [ -z "$version" ]; then
  echo "nodloop: no version in ${MANIFEST}" >&2
  exit 1
fi
TAG="v${version}"
# Every binary it runs compares itself with this and names a mismatch where the conversation reads it
export NODLOOP_PLUGIN_VERSION="$version"
BIN_DIR="${HOME}/.nodloop/bin/${TAG}"
BIN="${BIN_DIR}/nodloop"
# A stable path for the user. `~/.nodloop/bin/nodloop knowledge for --producer session` works after the first start
# It may name a PATH binary of unknown version until a later run caches or fetches the plugin version
STABLE="${HOME}/.nodloop/bin/nodloop"

# The guard hook runs through the stable path so that path must never go missing while a hook starts
# 1. a link that already names the target is left untouched so a cached start never rewrites it
# 2. otherwise a temp link is renamed over the old one because a rename replaces it in one step
stable() {
  [ "$(readlink "$STABLE" 2>/dev/null || true)" = "$1" ] && return 0
  mkdir -p "${HOME}/.nodloop/bin" 2>/dev/null || return 0
  tmp_link="${STABLE}.$$"
  if ln -sfn "$1" "$tmp_link" 2>/dev/null && mv -f "$tmp_link" "$STABLE" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp_link" 2>/dev/null || true
}

if [ -x "$BIN" ]; then
  stable "$BIN"
  exec "$BIN" "$@"
fi

os=$(uname -s | tr '[:upper:]' '[:lower:]')
arch=$(uname -m)
case "$arch" in
  x86_64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
esac
ARCHIVE="nodloop_${os}_${arch}.tar.gz"
BASE_URL="https://github.com/${REPO}/releases/download/${TAG}"

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
    return
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d ' ' -f 1
    return
  fi
  return 1
}

# Returns 1 when the release cannot be fetched so the next source is tried
# 1. a checksum mismatch exits because the download cannot be trusted
# 2. the binary is unpacked in a temp directory and renamed so the cached path never holds a partial file
fetch() {
  command -v curl >/dev/null 2>&1 || return 1
  mkdir -p "$BIN_DIR" || return 1
  tmp=$(mktemp -d "${BIN_DIR}/.fetch.XXXXXX") || return 1
  # Bounded so a hook never waits out its own timeout on a network that does not answer
  if ! curl -fsSL --connect-timeout 5 --max-time 60 "${BASE_URL}/${ARCHIVE}" -o "${tmp}/${ARCHIVE}" 2>/dev/null ||
    ! curl -fsSL --connect-timeout 5 --max-time 30 "${BASE_URL}/checksums.txt" -o "${tmp}/checksums.txt" 2>/dev/null; then
    rm -rf "$tmp"
    return 1
  fi
  if ! got=$(sha256 "${tmp}/${ARCHIVE}") || [ -z "$got" ]; then
    echo "nodloop: cannot compute the sha256 of ${ARCHIVE} with sha256sum or shasum, so it is not trusted" >&2
    rm -rf "$tmp"
    return 1
  fi
  want=$(awk -v f="$ARCHIVE" '$2 == f { print $1 }' "${tmp}/checksums.txt")
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    echo "nodloop: checksum of ${BASE_URL}/${ARCHIVE} does not match checksums.txt, refusing to run it" >&2
    rm -rf "$tmp"
    exit 1
  fi
  if ! tar -xzf "${tmp}/${ARCHIVE}" -C "$tmp" nodloop || ! chmod +x "${tmp}/nodloop" || ! mv -f "${tmp}/nodloop" "$BIN"; then
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$tmp"
  echo "nodloop: fetched ${BASE_URL}/${ARCHIVE} into ${BIN}" >&2
}

if fetch; then
  stable "$BIN"
  exec "$BIN" "$@"
fi

if command -v go >/dev/null 2>&1; then
  echo "nodloop: could not fetch release ${TAG} for ${os}/${arch}, building with go install" >&2
  if GOBIN="$BIN_DIR" go install "github.com/${REPO}/cmd/nodloop@${TAG}"; then
    stable "$BIN"
    exec "$BIN" "$@"
  fi
fi

# command -v may name this launcher itself when the plugin bin directory is on PATH
# The stable link is left alone when PATH finds it or its target because a link to itself would break it
# A relative PATH entry gives a relative name that would make a dangling link
found=$(command -v nodloop 2>/dev/null || true)
if [ -n "$found" ] && [ ! "$found" -ef "$0" ]; then
  have=$("$found" version 2>/dev/null || echo unknown)
  case "$have" in
    "$version" | "v$version") ;;
    *)
      # An older build lacks tools and flags the skills name and cannot warn about itself, so it runs only on request
      if [ "${NODLOOP_ALLOW_PATH:-}" != 1 ]; then
        echo "nodloop: ${found} on PATH is version ${have} but the plugin needs ${version} and could not fetch or build it. Restart Claude Code with network access, run go install github.com/${REPO}/cmd/nodloop@${TAG}, or set NODLOOP_ALLOW_PATH=1 where Claude Code starts to run that build anyway" >&2
        exit 1
      fi
      echo "nodloop: running a PATH build of version ${have} at ${found} where the plugin expects ${version} because NODLOOP_ALLOW_PATH is 1" >&2
      ;;
  esac
  case "$found" in
    /*) [ "$found" = "$STABLE" ] || [ "$found" -ef "$STABLE" ] || stable "$found" ;;
  esac
  exec "$found" "$@"
fi

echo "nodloop: could not fetch ${TAG} from ${BASE_URL} or build it with Go. Install Go from https://go.dev/dl and run again, or put a nodloop binary on PATH" >&2
exit 1
