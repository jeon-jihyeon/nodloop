{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeon-jihyeon/nodloop/schema/classify.v1.json",
  "title": "classify",
  "description": "The answers of every member a decision point asked",
  "type": "object",
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "classify"
    },
    "record_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "const": "classify"
    },
    "session_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        },
        "questions": {
          "description": "the instructions by name at the critic point and the names alone at every other point"
        }
      },
      "required": [
        "questions"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "members": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              },
              "answers": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "yes": {
                      "type": "number"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "yes"
                  ]
                }
              },
              "error": {
                "type": "string"
              },
              "ms": {
                "type": "integer"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "answers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "yes": {
                "type": "number"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "yes"
            ]
          }
        }
      },
      "required": [
        "members"
      ]
    },
    "error": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "thinking_tokens": {
          "type": "integer"
        },
        "cache_read": {
          "type": "integer"
        },
        "cache_create": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read",
        "cache_create",
        "cost_usd"
      ]
    },
    "duration_ms": {
      "type": "integer"
    },
    "tags": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "producer": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "string"
        }
      }
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "record_kind",
    "record_id",
    "id",
    "name",
    "time",
    "input",
    "usage",
    "duration_ms",
    "schema_version"
  ]
}
