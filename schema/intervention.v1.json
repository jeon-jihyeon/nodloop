{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeon-jihyeon/nodloop/schema/intervention.v1.json",
  "title": "intervention",
  "description": "One action of a person or an agent with the proof of its caller and the records it wrote",
  "type": "object",
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "intervention"
    },
    "record_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "const": "intervention"
    },
    "session_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "judge"
          ]
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "compaction": {
          "type": "string"
        },
        "choice": {
          "type": "string",
          "enum": [
            "keep",
            "undo",
            "scope"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "authority": {
          "type": "string",
          "enum": [
            "person",
            "agent"
          ]
        },
        "proof": {
          "type": "string",
          "enum": [
            "key",
            "terminal",
            "elicitation",
            "reply",
            "none"
          ]
        },
        "person": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "choice",
        "authority",
        "proof"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "records": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version",
              "status"
            ]
          }
        }
      },
      "required": [
        "records"
      ]
    },
    "error": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "thinking_tokens": {
          "type": "integer"
        },
        "cache_read": {
          "type": "integer"
        },
        "cache_create": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read",
        "cache_create",
        "cost_usd"
      ]
    },
    "duration_ms": {
      "type": "integer"
    },
    "tags": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "producer": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "string"
        }
      }
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "record_kind",
    "record_id",
    "id",
    "name",
    "time",
    "input",
    "usage",
    "duration_ms",
    "schema_version"
  ]
}
