{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeon-jihyeon/nodloop/schema/expose.v1.json",
  "title": "expose",
  "description": "A question or a notice shown to the person",
  "type": "object",
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "expose"
    },
    "record_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "const": "expose"
    },
    "session_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "direction",
            "shadow",
            "audit",
            "notice"
          ]
        },
        "key": {
          "type": "string"
        },
        "change": {
          "type": [
            "null",
            "object"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "integer"
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "surface": {
          "type": "string",
          "enum": [
            "additional_context",
            "system_message"
          ]
        },
        "rules": {
          "type": "string"
        },
        "choices": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "string",
            "enum": [
              "keep",
              "drop",
              "merge",
              "separate",
              "mine",
              "review",
              "yes",
              "notyet",
              "same",
              "undo",
              "no_answer"
            ]
          }
        },
        "text": {
          "type": "string"
        },
        "round": {
          "type": "integer"
        },
        "run": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "surface",
        "rules",
        "text",
        "round"
      ]
    },
    "error": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "thinking_tokens": {
          "type": "integer"
        },
        "cache_read": {
          "type": "integer"
        },
        "cache_create": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read",
        "cache_create",
        "cost_usd"
      ]
    },
    "duration_ms": {
      "type": "integer"
    },
    "tags": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "producer": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "string"
        }
      }
    },
    "draw": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "cycle_id": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "seed": {
          "type": "string"
        },
        "draw_id": {
          "type": "string"
        },
        "p": {
          "type": [
            "null",
            "number"
          ]
        },
        "drawn": {
          "type": "boolean"
        }
      },
      "required": [
        "cycle_id",
        "policy_version",
        "drawn"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "push",
        "manual",
        "command"
      ]
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "record_kind",
    "record_id",
    "id",
    "name",
    "time",
    "input",
    "usage",
    "duration_ms",
    "schema_version"
  ]
}
