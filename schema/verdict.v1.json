{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeon-jihyeon/nodloop/schema/verdict.v1.json",
  "title": "verdict",
  "description": "A verdict on a run: approve, edit, reject or withdraw",
  "type": "object",
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "verdict"
    },
    "record_id": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "edit",
        "reject",
        "withdraw"
      ]
    },
    "reason_code": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "edited": true,
    "reviewer": {
      "type": "string"
    },
    "proof": {
      "type": "string",
      "enum": [
        "key",
        "terminal",
        "elicitation",
        "reply",
        "none"
      ]
    },
    "audit": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "record_kind",
    "record_id",
    "trace_id",
    "time",
    "verdict",
    "reviewer",
    "schema_version"
  ]
}
